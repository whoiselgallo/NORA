# 1. Base de Datos Postgres Serverless (Neon Free Tier - 0.5 GiB, Auto-suspend)
# Conexión 'pooled' para APIs Serverless y microservicios (PgBouncer integrado en Neon):
DATABASE_URL="postgresql://neondb_owner:TU_PASSWORD@ep-quiet-forest-b503dzg6-pooler.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require"
# Conexión directa (unpooled) para migraciones DDL pesadas:
DATABASE_URL_UNPOOLED="postgresql://neondb_owner:TU_PASSWORD@ep-quiet-forest-b503dzg6.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 2. Redis Caché & Rate Limiting Serverless (Upstash Free Tier - 10,000 req/día)
# Si se deja en blanco o sin definir, el sistema conmuta automáticamente a fallback en memoria:
UPSTASH_REDIS_URL="rediss://default:TU_UPSTASH_TOKEN@us1-evident-cow-32145.upstash.io:6379"
# Alternativa genérica (o Redis local):
# REDIS_URL="redis://127.0.0.1:6379"

# 3. Alertas SRE y Monitoreo en Tiempo Real (Discord / Slack Incoming Webhook - 100% Gratis)
# Crea un Webhook en tu canal de Discord (Canal -> Ajustes -> Integraciones -> Crear Webhook):
DISCORD_ALERTS_WEBHOOK_URL="https://discord.com/api/webhooks/TU_WEBHOOK_ID/TU_WEBHOOK_TOKEN"

# 4. Servidor Express y Runtime
PORT=4000
NODE_ENV=production

# 5. Seguridad de Webhooks de TSOLUTIONS (Firma Criptográfica HMAC-SHA256)
WEBHOOK_SECRET_KEY="whsec_tsolutions_enterprise_key_2026"
